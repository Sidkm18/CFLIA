limit_req_zone $binary_remote_addr zone=global:10m rate=15r/s;
map $request_method $signin_key { default ""; POST $binary_remote_addr; }
limit_req_zone $signin_key zone=signin:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=reports:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=connections:10m;
server_tokens off;
limit_req_status 429;
limit_conn_status 429;
client_max_body_size 16k;
server {
    listen ${PORT} default_server;
    server_name _;
    keepalive_timeout 10s;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 10s;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control no-store always;
    add_header X-Request-ID $request_id always;
    limit_conn connections 12;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Proxy "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Cache-Control;
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Request-ID;
    location = /login {
        limit_req zone=signin burst=8 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location = /reports/export {
        limit_req zone=reports burst=4 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        limit_req zone=global burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
}
